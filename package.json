{
  "name": "@clarin-eric/fcs-sru-aggregator-api-adapter-typescript",
  "version": "2.2.0-dev",
  "description": "A typescript API adapter for the CLARIN FCS SRU Aggregator REST API",
  "keywords": [
    "fcs",
    "search",
    "rest",
    "api",
    "clarin"
  ],
  "type": "module",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/clarin-eric/fcs-sru-aggregator-api-adapter-typescript#readme",
  "bugs": {
    "url": "https://github.com/clarin-eric/fcs-sru-aggregator-api-adapter-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clarin-eric/fcs-sru-aggregator-api-adapter-typescript.git"
  },
  "author": "Erik Körner <koerner@saw-leipzig.de>",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}